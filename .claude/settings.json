{
  "permissions": {
    "allow": [
      "mcp__shadcn-studio-mcp__get-blocks-metadata",
      "mcp__shadcn-studio-mcp__get-block-meta-content",
      "mcp__shadcn-studio-mcp__get-component-content",
      "mcp__shadcn-studio-mcp__get-component-meta-content",
      "mcp__shadcn-studio-mcp__get-inspiration-block-content",
      "mcp__shadcn-studio-mcp__get-create-instructions",
      "mcp__shadcn-studio-mcp__get-refine-instructions",
      "mcp__shadcn-studio-mcp__get-inspire-instructions",
      "mcp__shadcn-studio-mcp__get-ftc-instructions",
      "mcp__shadcn-studio-mcp__parse-figma-blocks",
      "Bash(npx shadcn@latest add @ss-components/:*)",
      "Bash(npx shadcn@latest add @ss-blocks/:*)",
      "Bash(npx shadcn@latest add @ss-themes/:*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "mcp__figma__get_metadata",
      "mcp__figma__get_design_context",
      "mcp__figma__get_variable_defs",
      "mcp__figma__get_screenshot"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__shadcn-studio-mcp__collect_selected_blocks|mcp__shadcn-studio-mcp__collect_selected_components|mcp__shadcn-studio-mcp__get_add_command_for_items|mcp__shadcn-studio-mcp__get_add_command_for_components|mcp__shadcn-studio-mcp__install-theme",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-shadcn-studio.sh\"",
            "timeout": 10,
            "statusMessage": "Checking shadcn/ui + Shadcn Studio setup..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-shadcn-studio.sh\"",
            "if": "Bash(npx shadcn*)",
            "timeout": 10,
            "statusMessage": "Checking shadcn/ui + Shadcn Studio setup..."
          }
        ]
      }
    ]
  }
}
